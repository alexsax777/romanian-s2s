# Copiază în .env și completează local — cheile nu intră niciodată în git/loguri.
# Notă: adapterul acceptă și numele GONKA_API_KEY (cel folosit deja de Hermes).
GONKAROUTER_BASE_URL=https://api.gonkarouter.io/v1
GONKAROUTER_API_KEY=
GONKAROUTER_MODEL=zai-org/GLM-5.3-Flash

XKIRO_BASE_URL=https://api.xkiro.com/v1
XKIRO_API_KEY=
XKIRO_MODEL=qwen/qwen3.7-flash:free

LLM_CONNECT_TIMEOUT=10
LLM_REQUEST_TIMEOUT=60
LLM_FALLBACK_MAX_RETRIES=1
